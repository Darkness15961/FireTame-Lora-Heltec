# fireTame-heltec — plantilla de secretos
# Copia a .env y rellena. NUNCA subas .env a GitHub.

# --- The Things Network ---
TTN_APPLICATION_ID=heltec-v3-peru
TTN_CLUSTER=nam1
TTN_WEBHOOK_SECRET=cambia_este_secreto

# --- Supabase (dashboard Vue + Edge Function) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Front (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Nodo 1 (heltec-wifi-lora-32-v3 / ChipID E4B4B743CA48) ---
NODO1_DEVEUI=70B3D57ED0079581
NODO1_APPEUI=0000000000000000
NODO1_APPKEY=
NODO1_LICENSE_0=0x00000000
NODO1_LICENSE_1=0x00000000
NODO1_LICENSE_2=0x00000000
NODO1_LICENSE_3=0x00000000
# ABP opcional (no usado si OTAA=true)
NODO1_NWKSKEY=
NODO1_APPSKEY=
NODO1_DEVADDR=00000000

# --- Nodo 2 (heltec-nodo-2 / ChipID 60BCB743CA48) ---
NODO2_DEVEUI=70B3D57ED0079582
NODO2_APPEUI=0000000000000000
NODO2_APPKEY=
NODO2_LICENSE_0=0x00000000
NODO2_LICENSE_1=0x00000000
NODO2_LICENSE_2=0x00000000
NODO2_LICENSE_3=0x00000000

# --- Nodo 3 (heltec-nodo-3 / ChipID 60ACB743CA48) ---
NODO3_DEVEUI=70B3D57ED0079584
NODO3_APPEUI=0000000000000000
NODO3_APPKEY=
NODO3_LICENSE_0=0x00000000
NODO3_LICENSE_1=0x00000000
NODO3_LICENSE_2=0x00000000
NODO3_LICENSE_3=0x00000000
